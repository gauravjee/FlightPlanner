--- /dev/null
+++ b/.env.example
@@ -0,0 +1,40 @@
+# Copy this file to .env.local and fill in real values.
+# .env.local is already gitignored — never commit real secrets.
+
+# ------------------------------------------------------------------
+# Supabase
+# ------------------------------------------------------------------
+# Project URL and anon (public) key — safe to expose to the browser,
+# used by every client-side Supabase call in the app.
+NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
+NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
+
+# Service role key — server-only, NEVER prefix this with NEXT_PUBLIC_ or
+# expose it to the browser. It bypasses Row Level Security entirely.
+# Used by lib/supabase-admin.ts (password verification/reset, admin user
+# management) and the notifications cron route. Find it in your Supabase
+# project settings under API → service_role key.
+SUPABASE_SERVICE_KEY=your-service-role-key
+
+# ------------------------------------------------------------------
+# NextAuth
+# ------------------------------------------------------------------
+# Random secret used to sign session tokens. Generate one with:
+#   openssl rand -base64 32
+NEXTAUTH_SECRET=
+
+# ------------------------------------------------------------------
+# Resend (transactional email)
+# ------------------------------------------------------------------
+# Server-only — do not prefix with NEXT_PUBLIC_.
+RESEND_API_KEY=re_your_key_here
+
+# ------------------------------------------------------------------
+# Cron endpoint
+# ------------------------------------------------------------------
+# Shared secret required by /api/cron/check-notifications. Set this,
+# then configure your scheduler (e.g. cron-job.org) to call the endpoint
+# with either header `Authorization: Bearer <value>` or `?secret=<value>`.
+# If left unset, the endpoint runs unauthenticated — a warning is logged
+# on every request as a reminder to set it.
+CRON_SECRET=
